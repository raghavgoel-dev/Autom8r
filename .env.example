# Root template. The backend reads backend/.env (copy backend/.env.example).
# This root file documents every variable in one place for the demo.

APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

ADMIN_TOKEN=change-me
WEBHOOK_SECRET=change-me

GOOGLE_SHEETS_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

CORS_ORIGINS=http://localhost:5173

# Frontend (Vite) — base URL of the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000
