# Backend runtime configuration (copy to .env and edit).
# .env is gitignored. NEVER commit real secrets.

APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# SQLite database URL. Default (when unset) is <repo-root>/data/autom8r.db,
# resolved from this file's location so any working directory works.
# DATABASE_URL=sqlite:///./data/autom8r.db

# MCP server the backend connects to (Streamable HTTP endpoint).
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# LLM. LLM_ENABLED=false -> deterministic MockLLMService (no key needed).
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Demo auth secrets. Change these. Never commit real values.
ADMIN_TOKEN=change-me
WEBHOOK_SECRET=change-me

# Optional Google Sheets sync (adapter pattern, off by default).
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
